# Base de datos. En local usa SQLite. En producción, usar Postgres
# (ver README) y cambiar también el provider en prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Clave para entrar al panel de administración (/admin).
ADMIN_PASSWORD="cambia-esta-clave"

# Frase secreta para firmar la sesión del admin (cualquier texto largo y único).
SESSION_SECRET="cambia-este-secreto-tambien"

# Se agrega cuando tu prima tenga la cuenta de Mercado Pago (Access Token
# de PRODUCCIÓN, del panel de desarrolladores de Mercado Pago).
MERCADOPAGO_ACCESS_TOKEN=""

# URL pública del sitio (para armar los links de retorno de Mercado Pago).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
