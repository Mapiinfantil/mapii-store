# Base de datos. En local usa un archivo SQLite. En producción (Railway)
# se usa una ruta absoluta dentro del disco persistente, ver README.
DATABASE_URL="file:./dev.db"

# Clave maestra para crear la primera cuenta de administrador la primera
# vez que se entra a /admin/login. Después de eso ya no se vuelve a pedir.
ADMIN_PASSWORD="cambia-esta-clave"

# Frase secreta para firmar la sesión del admin (cualquier texto largo y único).
SESSION_SECRET="cambia-este-secreto-tambien"

# Se agrega cuando tu prima tenga la cuenta de Mercado Pago (Access Token
# de PRODUCCIÓN, del panel de desarrolladores de Mercado Pago).
MERCADOPAGO_ACCESS_TOKEN=""

# URL pública del sitio (para armar los links de retorno de Mercado Pago).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Dónde se guardan las fotos de productos que se suben desde el admin.
# En local no hace falta tocarlo. En Railway, usar /data/uploads (mismo
# disco persistente que la base de datos), ver README.
UPLOADS_DIR=""
